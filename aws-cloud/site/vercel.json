{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build && npm run db:deploy",
  "outputDirectory": "dist",
  "regions": [
    "sin1"
  ],
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/on-tap",
      "destination": "/practice/",
      "permanent": true
    },
    {
      "source": "/on-tap/:path*",
      "destination": "/practice/:path*",
      "permanent": true
    },
    {
      "source": "/concepts/:id/kiem-tra",
      "destination": "/concepts/:id/quiz/",
      "permanent": true
    },
    {
      "source": "/concepts/:id/kiem-tra/",
      "destination": "/concepts/:id/quiz/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__route=/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api?__route=/auth/:path*"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
