{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "redirects": [
    {
      "source": "/on-tap",
      "destination": "/practice/",
      "permanent": true
    },
    {
      "source": "/on-tap/:path*",
      "destination": "/practice/:path*",
      "permanent": true
    },
    {
      "source": "/concepts/:id/kiem-tra",
      "destination": "/concepts/:id/quiz/",
      "permanent": true
    },
    {
      "source": "/concepts/:id/kiem-tra/",
      "destination": "/concepts/:id/quiz/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
