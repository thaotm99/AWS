---
import "../styles/global.css";
import Roadmap from "../components/Roadmap.tsx";
import { getCollection } from "astro:content";
import { getCurriculum } from "../data/exam";
import T from "../app/T.astro";
import type { SiteMessageKey } from "../app/i18n";
import type { MessageParams } from "../core/i18n/types";
import LanguageSwitch from "../modules/shell/ui/LanguageSwitch.astro";
import { BrowserLocalePreference } from "../core/i18n/LocalePreference";

interface Props {
  title: string;
  description?: string;
  current?: string;
  /** Top-nav section this page belongs to. */
  section?: "theory" | "practice";
  /** Practice pages have no lesson roadmap. */
  sidebar?: boolean;
  /** Translated <title>; `title` stays as the default-language text. */
  titleKey?: SiteMessageKey;
  titleParams?: MessageParams;
}

const {
  title,
  description = "Ôn thi AWS Solutions Architect Associate (SAA-C03) qua hình minh họa và mô phỏng tương tác, bám theo câu hỏi đề thi.",
  current,
  section = "theory",
  sidebar = true,
  titleKey,
  titleParams,
} = Astro.props;
// Runs before first paint: hide translatable text until the chosen language is applied.
const earlyLocale = `try{var l=localStorage.getItem(${JSON.stringify(BrowserLocalePreference.storageKey)});if(l&&l!=="vi"){var h=document.documentElement;h.lang=l;h.classList.add("i18n-pending");setTimeout(function(){h.classList.remove("i18n-pending")},2000)}}catch(e){}`;
const ready = (await getCollection("concepts")).map((e) => e.id);
const layers = getCurriculum();
---
<!doctype html>
<html lang="vi" data-i18n-title={titleKey} data-i18n-params={titleParams ? JSON.stringify(titleParams) : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline set:html={earlyLocale} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16"><rect x="1" y="9" width="14" height="5" rx="1" fill="#fff"/><rect x="3" y="4" width="10" height="4" rx="1" fill="#fff" opacity=".75"/><rect x="5" y="1" width="6" height="2" rx="1" fill="#fff" opacity=".5"/></svg>
          </span>
          <span class="brand-text">AWS Từ Nền</span>
        </a>
        <nav class="topnav" aria-label="Chính" data-i18n-attr="aria-label:shell.nav.main">
          <a href="/" aria-current={section === "theory" ? "page" : undefined}><T k="shell.nav.theory" /></a>
          <a href="#" class="soon" data-soon="shell.nav.scenarios"><T k="shell.nav.scenarios" /></a>
          <a href="/on-tap/" aria-current={section === "practice" ? "page" : undefined}><T k="shell.nav.practice" /></a>
        </nav>
        <LanguageSwitch />
        {sidebar && <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="sidebar"><T k="shell.nav.roadmap" /></button>}
      </div>
    </header>

    <div class:list={["shell", { single: !sidebar }]}>
      {sidebar && (
        <aside class="sidebar" id="sidebar" aria-label="Lộ trình học" data-i18n-attr="aria-label:shell.nav.roadmap">
          <Roadmap client:load layers={layers} current={current} ready={ready} />
        </aside>
      )}
      <main class="article">
        <slot />
      </main>
    </div>
    <div class="toast" id="toast" hidden></div>

    <script>
      import { i18n } from "../app/i18n";
      import { ShellController } from "../modules/shell/ui/ShellController";

      new ShellController(i18n).start();
    </script>
  </body>
</html>
