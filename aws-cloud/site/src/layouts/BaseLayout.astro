---
import "../styles/global.css";
import Roadmap from "../components/Roadmap.tsx";
import { getCollection } from "astro:content";
import { getCurriculum } from "../data/exam";
import T from "../app/T.astro";
import type { SiteMessageKey } from "../app/i18n";
import type { MessageParams } from "../core/i18n/types";
import LanguageSwitch from "../modules/shell/ui/LanguageSwitch.astro";
import ThemeToggle from "../modules/shell/ui/ThemeToggle.astro";
import { DEFAULT_LOCALE } from "../core/i18n/types";
import { DEFAULT_THEME, THEMES } from "../core/theme/types";
import islandScript from "astro/runtime/server/astro-island.prebuilt.js";
import { ISLAND_STYLES } from "astro/runtime/server/astro-island-styles.js";
import loadScript from "astro/client/load.prebuilt.js";
import idleScript from "astro/client/idle.prebuilt.js";
import visibleScript from "astro/client/visible.prebuilt.js";
import onlyScript from "astro/client/only.prebuilt.js";

interface Props {
  title: string;
  description?: string;
  current?: string;
  /** The page is the current lesson's question set, not the lesson itself. */
  currentQuiz?: boolean;
  /** Top-nav section this page belongs to. */
  section?: "theory" | "practice" | "glossary";
  /** Practice pages have no lesson roadmap. */
  sidebar?: boolean;
  /** Full-width content (home page map); only used without the sidebar. */
  wide?: boolean;
  /** Translated <title>; `title` stays as the default-language text. */
  titleKey?: SiteMessageKey;
  titleParams?: MessageParams;
}

const {
  title,
  description = "Học AWS qua hình minh họa và mô phỏng tương tác, đi từ những tình huống thực tế của một cửa hàng online.",
  current,
  currentQuiz = false,
  section = "theory",
  sidebar = true,
  wide = false,
  titleKey,
  titleParams,
} = Astro.props;
// Runs before first paint, before any bundle: apply the saved theme (no flash of the
// wrong colors) and hide translatable text until the saved language is applied.
// Keys match the preference fields in modules/shell (localStorage "theme", "locale").
const earlyPreferences = `(function(){var h=document.documentElement,t=${JSON.stringify(DEFAULT_THEME)};try{var s=localStorage.getItem("theme");if(${JSON.stringify(THEMES)}.indexOf(s)>=0)t=s;var l=localStorage.getItem("locale");if(l&&l!==${JSON.stringify(DEFAULT_LOCALE)}){h.lang=l;h.classList.add("i18n-pending");setTimeout(function(){h.classList.remove("i18n-pending")},2000)}}catch(e){}h.dataset.theme=t})();`;
const toc = Astro.slots.has("toc");
const ready = (await getCollection("concepts")).map((e) => e.id);
// Only what the roadmap shows reaches the browser.
const layers = getCurriculum().map(({ n, name, nameEn, concepts }) => ({
  n,
  name,
  nameEn,
  concepts: concepts.map(({ id, title, titleEn, importance, intro, questions, exact }) => ({ id, title, titleEn, importance, intro, quiz: exact ? questions : 0 })),
}));
---
<!doctype html>
<html lang="vi" data-i18n-title={titleKey} data-i18n-params={titleParams ? JSON.stringify(titleParams) : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline set:html={earlyPreferences} />
    {/* Island bootstrap, always in the head. Astro emits it next to the first island it renders, but a
        lesson page renders every part of the lesson MDX and keeps only one, so the copy Astro emits
        can be thrown away with a hidden part and the visible islands would never hydrate. The scripts
        are idempotent, so Astro's own copies on the page do no harm. */}
    <style is:inline set:html={ISLAND_STYLES} />
    <script is:inline set:html={loadScript + idleScript + visibleScript + onlyScript} />
    <script is:inline set:html={islandScript} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <button class="menu-btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="drawer" aria-label="Mở menu" data-i18n-attr="aria-label:shell.nav.openMenu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path class="icon-open" d="M4 7h16M4 12h16M4 17h16" /><path class="icon-close" d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16"><rect x="1" y="9" width="14" height="5" rx="1" fill="currentColor"/><rect x="3" y="4" width="10" height="4" rx="1" fill="currentColor" opacity=".75"/><rect x="5" y="1" width="6" height="2" rx="1" fill="currentColor" opacity=".5"/></svg>
          </span>
          <span class="brand-text">AWS Thực Chiến</span>
        </a>
        <nav class="topnav" aria-label="Chính" data-i18n-attr="aria-label:shell.nav.main">
          <a href="/" aria-current={section === "theory" ? "page" : undefined}><T k="shell.nav.theory" /></a>
          <a href="#" class="soon" data-soon="shell.nav.scenarios"><T k="shell.nav.scenarios" /></a>
          <a href="/practice/" aria-current={section === "practice" ? "page" : undefined}><T k="shell.nav.practice" /></a>
          <a href="/glossary/" aria-current={section === "glossary" ? "page" : undefined}><T k="shell.nav.glossary" /></a>
        </nav>
        <LanguageSwitch />
        <ThemeToggle />
      </div>
      {toc && <div class="read-bar" aria-hidden="true"><i /></div>}
    </header>

    <div class:list={["shell", { single: !sidebar, wide: !sidebar && wide, "with-toc": toc }]}>
      <!-- Sidebar on desktop; on phones the same element is the ☰ drawer, which also carries the main links. -->
      <aside class:list={["sidebar", { "nav-only": !sidebar }]} id="drawer" aria-label="Menu" data-i18n-attr="aria-label:shell.nav.menu">
        <nav class="drawer-nav" aria-label="Chính" data-i18n-attr="aria-label:shell.nav.main">
          <a href="/" aria-current={section === "theory" ? "page" : undefined}><T k="shell.nav.theory" /></a>
          <a href="#" class="soon" data-soon="shell.nav.scenarios"><T k="shell.nav.scenarios" /></a>
          <a href="/practice/" aria-current={section === "practice" ? "page" : undefined}><T k="shell.nav.practice" /></a>
          <a href="/glossary/" aria-current={section === "glossary" ? "page" : undefined}><T k="shell.nav.glossary" /></a>
        </nav>
        {sidebar && <Roadmap client:load layers={layers} current={current} currentQuiz={currentQuiz} ready={ready} />}
      </aside>
      <div class="scrim" id="scrim" hidden></div>
      <main class="article">
        <slot />
      </main>
      {toc && <aside class="toc-col"><slot name="toc" /></aside>}
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

    <script>
      import { i18n } from "../app/i18n";
      import { theme } from "../app/theme";
      import { ShellController } from "../modules/shell/ui/ShellController";
      import { diagramZoom } from "../app/zoom";

      new ShellController(i18n, theme).start();
      diagramZoom.start();
    </script>
  </body>
</html>
