---
import BaseLayout from "../layouts/BaseLayout.astro";
import T from "../app/T.astro";
---
<BaseLayout title="Đang offline · CloudLab" titleKey="shell.offline.title" sidebar={false}>
  <h1><T k="shell.offline.title" /></h1>
  <p class="lede"><T k="shell.offline.body" /></p>
  <h2 class="mt-6 text-[1.1rem]"><T k="shell.offline.saved" /></h2>
  <ul class="my-4 grid list-disc gap-1.5 pl-5" id="offline-list"></ul>
  <p id="offline-none" hidden><T k="shell.offline.none" /></p>
</BaseLayout>

<script>
  // Lesson pages already in the offline cache, so the reader knows what they can open without a connection.
  const list = document.getElementById("offline-list")!;
  const none = document.getElementById("offline-none")!;
  (async () => {
    // Each saved page by its title, read from the saved copy (without the site name), else its address.
    const pages = new Map<string, string>();
    if ("caches" in window) {
      for (const key of await caches.keys()) {
        if (!key.startsWith("pages-")) continue;
        const cache = await caches.open(key);
        for (const req of await cache.keys()) {
          const path = new URL(req.url).pathname;
          if (pages.has(path) || !(path.startsWith("/concepts/") || path.startsWith("/glossary/") || path.startsWith("/flashcards/"))) continue;
          const html = await (await cache.match(req))?.text().catch(() => "");
          const raw = html?.match(/<title>([^<]*)<\/title>/)?.[1] ?? "";
          const title = new DOMParser().parseFromString(raw, "text/html").documentElement.textContent?.replace(/\s*·\s*CloudLab\s*$/, "").trim();
          pages.set(path, title || path);
        }
      }
    }
    for (const [path, title] of [...pages].sort((a, b) => a[0].localeCompare(b[0]))) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = path;
      a.textContent = title;
      li.append(a);
      list.append(li);
    }
    none.hidden = pages.size > 0;
  })();
</script>
