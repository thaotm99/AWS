---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import MockExamPage from "../../../../../modules/practice/ui/MockExamPage.tsx";
import { practiceCatalog } from "../../../../../modules/practice/content/PracticeCatalog";

export function getStaticPaths() {
  return practiceCatalog.examPaths().map(({ cert, exam }) => ({
    params: { cert, exam },
    props: { code: practiceCatalog.getCertification(cert).code, number: practiceCatalog.getExam(cert, exam).number },
  }));
}

const { cert, exam } = Astro.params;
const { code, number } = Astro.props;
---
<BaseLayout
  title={`Thi thử · Đề ${number} · ${code} · CloudLab`}
  titleKey="practice.mock.pageTitle"
  titleParams={{ code, n: number }}
  section="practice"
  sidebar={false}
>
  <MockExamPage client:only="react" certId={cert} examId={exam} />
</BaseLayout>
