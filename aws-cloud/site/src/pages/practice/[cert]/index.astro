---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import T from "../../../app/T.astro";
import CatalogPage from "../../../modules/practice/ui/CatalogPage.tsx";
import { practiceCatalog } from "../../../modules/practice/content/PracticeCatalog";
import "../../../styles/practice.css";

export function getStaticPaths() {
  return practiceCatalog.listCertifications().map((cert) => ({ params: { cert: cert.id }, props: { cert } }));
}

const { cert } = Astro.props;
---
<BaseLayout
  title={`Đề luyện tập ${cert.code} · CloudLab`}
  titleKey="practice.catalog.certPageTitle"
  titleParams={{ code: cert.code }}
  description={`Đề luyện tập ${cert.code} ${cert.name}, làm lần lượt từng câu.`}
  section="practice"
  sidebar={false}
>
  <div class="crumbs"><a href="/practice/"><T k="practice.catalog.crumb" /></a><span aria-hidden="true">/</span><b>{cert.code}</b></div>
  <h1><T k="practice.catalog.title" /></h1>
  <p class="lede"><T k="practice.catalog.lede" /></p>
  <CatalogPage client:only="react" certId={cert.id} />
</BaseLayout>
