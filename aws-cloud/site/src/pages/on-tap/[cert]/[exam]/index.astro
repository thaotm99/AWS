---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ExamPage from "../../../../modules/practice/ui/ExamPage.tsx";
import { practiceCatalog } from "../../../../modules/practice/content/PracticeCatalog";
import "../../../../styles/practice.css";

export function getStaticPaths() {
  return practiceCatalog.examPaths().map(({ cert, exam }) => ({
    params: { cert, exam },
    props: { code: practiceCatalog.getCertification(cert).code, number: practiceCatalog.getExam(cert, exam).number },
  }));
}

const { cert, exam } = Astro.params;
const { code, number } = Astro.props;
---
<BaseLayout
  title={`${code} · Đề ${number} · Ôn tập`}
  titleKey="practice.catalog.examPageTitle"
  titleParams={{ code, n: number }}
  section="practice"
  sidebar={false}
>
  <ExamPage client:only="react" certId={cert} examId={exam} />
</BaseLayout>
