---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import L from "../../components/L.astro";
import Donate from "../../components/Donate.astro";
import DoneButton from "../../components/DoneButton.tsx";
import Importance from "../../components/Importance.astro";
import T from "../../app/T.astro";
import { findConcept } from "../../data/curriculum";
import { getCurriculum } from "../../data/exam";

export async function getStaticPaths() {
  const entries = await getCollection("concepts");
  const ids = getCurriculum().flatMap((l) => l.concepts.map((c) => c.id));
  const orphan = entries.find((e) => !ids.includes(e.id));
  if (orphan) throw new Error(`concepts/${orphan.id}.mdx has no matching id in curriculum.ts`);
  return ids.map((id) => ({ params: { id }, props: { entry: entries.find((e) => e.id === id) } }));
}

const { id } = Astro.params;
const { entry } = Astro.props;
const layers = getCurriculum();
const concept = findConcept(layers, id)!;
const { Content } = entry ? await render(entry) : { Content: null };
const entryEn = entry ? await getEntry("conceptsEn", id) : undefined;
const { Content: ContentEn } = entryEn ? await render(entryEn) : { Content: null };

const all = layers.flatMap((l) => l.concepts);
const index = all.findIndex((c) => c.id === id);
const next = all.slice(index + 1, index + 4);
const ready = new Set((await getCollection("concepts")).map((e) => e.id));
const prereqs = (entry?.data.prerequisites ?? []).map((p) => findConcept(layers, p)).filter(Boolean);
const title = entry?.data.title ?? concept.title;
const titleEn = entryEn?.data.title ?? concept.titleEn;
// Docs links are the same pages in both languages; the English file may add its own.
const docs = [...(entry?.data.docs ?? []), ...(entryEn?.data.docs ?? [])].filter((d, i, list) => list.findIndex((x) => x.url === d.url) === i);
---
<BaseLayout title={`${concept.title} · AWS Thực Chiến`} description={entry?.data.lede} current={id}>
  {entry && (
    <nav slot="toc" class="ltoc" id="toc" aria-label="Mục lục bài học" data-i18n-attr="aria-label:shell.toc.label">
      <div class="toc-head">
        <span class="side-label"><T k="shell.toc.progress" /></span>
        <span class="toc-percent" data-read-percent>0%</span>
      </div>
      <p class="toc-lesson"><L vi={title} en={titleEn} /></p>
      <div class="side-label toc-title"><T k="shell.toc.title" /></div>
      <ol></ol>
      <div class="toc-bar" aria-hidden="true"><i /></div>
      <p class="toc-keys"><kbd>J</kbd> / <kbd>K</kbd> <T k="shell.toc.jump" /></p>
    </nav>
  )}
  <div class="crumbs">
    <span><T k="lesson.frame.layer" params={{ n: concept.layer.n }} /> · <L vi={concept.layer.name} en={concept.layer.nameEn} /></span>
    <span aria-hidden="true">/</span><b><L vi={concept.title} en={concept.titleEn} /></b>
  </div>
  <h1><L vi={title} en={titleEn} /></h1>
  {entry && <p class="lede"><L vi={entry.data.lede} en={entryEn?.data.lede ?? entry.data.lede} /></p>}
  <dl class="meta-row">
    <div>
      <dt><T k="shell.importance.label" /></dt>
      <dd><Importance level={concept.importance} hint /></dd>
    </div>
    {entry && (
      <>
        <div>
          <dt><T k="lesson.frame.prerequisites" /></dt>
          <dd>
            {prereqs.length
              ? prereqs.map((p) => <a href={`/concepts/${p!.id}/`}><L vi={p!.title} en={p!.titleEn} /></a>)
              : <T k="lesson.frame.noPrerequisites" />}
          </dd>
        </div>
        <div>
          <dt><T k="lesson.frame.duration" /></dt>
          <dd><T k="lesson.frame.durationValue" params={{ minutes: entry.data.minutes, scenes: entry.data.scenes }} /></dd>
        </div>
        <div><dt><T k="lesson.frame.progress" /></dt><dd><DoneButton client:load id={id} /></dd></div>
      </>
    )}
  </dl>

  {Content ? (
    <>
      {ContentEn ? (
        <>
          <div data-lang="vi"><Content /></div>
          <div data-lang="en"><ContentEn /></div>
        </>
      ) : (
        <>
          <p class="untranslated" data-lang="en"><T k="lesson.frame.untranslated" /></p>
          <Content />
        </>
      )}
      <section class="scene prose" id="next">
        <div class="scene-head">
          <span class="scene-no"><T k="lesson.frame.nextLabel" /></span>
          <h2><T k="lesson.frame.nextTitle" /></h2>
        </div>
        <div class="next">
          <div class="next-col">
            <h3><T k="lesson.frame.nextLessons" /></h3>
            <ul>
              {next.map((c) => (
                <li>
                  <a href={`/concepts/${c.id}/`}><L vi={c.title} en={c.titleEn} /></a>
                  {!ready.has(c.id) && <span class="tag-soon"><T k="lesson.frame.soon" /></span>}
                </li>
              ))}
            </ul>
          </div>
          <div class="next-col">
            <h3><T k="lesson.frame.practice" /></h3>
            <ul>
              {concept.exact && concept.questions > 0 && (
                <li><a href={`/concepts/${id}/kiem-tra/`}><T k="lesson.frame.quizLink" params={{ n: concept.questions }} /></a></li>
              )}
              <li><a href="/on-tap/"><T k="lesson.frame.practiceLink" /></a></li>
            </ul>
          </div>
          <div class="next-col">
            <h3><T k="lesson.frame.docs" /></h3>
            <ul>{docs.map((d) => <li><a href={d.url} target="_blank" rel="noopener">{d.title}</a></li>)}</ul>
          </div>
        </div>
      </section>
      <Donate />
    </>
  ) : (
    <div class="placeholder">
      <p><T k="lesson.frame.placeholder" /></p>
      <a class="btn cta" href="/concepts/global-infra/"><T k="lesson.frame.placeholderCta" /></a>
    </div>
  )}
</BaseLayout>

<script>
  import { i18n } from "../../app/i18n";
  import { LessonToc } from "../../modules/shell/ui/LessonToc";

  const root = document.getElementById("toc");
  const content = document.querySelector<HTMLElement>("main.article");
  if (root && content) {
    const toc = new LessonToc(root, content);
    toc.start();
    // Each language has its own copy of the lesson; rebuild the contents for the visible one.
    i18n.subscribe(() => requestAnimationFrame(() => toc.refresh()));
  }
</script>
