---
import BaseLayout from "../../layouts/BaseLayout.astro";
import T from "../../app/T.astro";
import L from "../../components/L.astro";
import ServiceCompare from "../../components/compare/ServiceCompare.tsx";
import { COMPARE, type CompareSet } from "../../lib/compare";
import { lessonParts } from "../../data/lesson-parts";

export function getStaticPaths() {
  return COMPARE.map((set) => ({ params: { id: set.id }, props: { set } }));
}

const { set } = Astro.props as { set: CompareSet };
const part = lessonParts(set.learn.lesson).find((p) => p.slug === set.learn.part);
if (!part) throw new Error(`compare ${set.id}: no part ${set.learn.lesson}/${set.learn.part}`);
const head = (s: string) => s.split(": ")[0];
const learn = { href: `/concepts/${set.learn.lesson}/${set.learn.part}/`, vi: head(part.title.vi), en: head(part.title.en) };
---
<BaseLayout title={`${set.title.vi} · So sánh dịch vụ · CloudLab`} description={set.lede.vi} section="lab" sidebar={false}>
  <header class="gl-head lab-head">
    <span class="gl-eyebrow"><a href="/lab/"><T k="shell.lab.eyebrow" /></a> · <T k="shell.compare.eyebrow" /></span>
    <h1><L vi={set.title.vi} en={set.title.en} /></h1>
    <p class="lede"><L vi={set.lede.vi} en={set.lede.en} /></p>
  </header>
  <nav class="cmp-tabs" aria-label="So sánh khác" data-i18n-attr="aria-label:shell.compare.others">
    {COMPARE.map((c) => (
      <a href={`/compare/${c.id}/`} aria-current={c.id === set.id ? "page" : undefined}><L vi={c.title.vi} en={c.title.en} /></a>
    ))}
  </nav>
  <ServiceCompare client:load id={set.id} learn={learn} />
</BaseLayout>
