---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import T from "../app/T.astro";
import { getCurriculum } from "../data/exam";
import ArchitectureMap from "../components/home/ArchitectureMap.tsx";
import { practiceCatalog } from "../modules/practice/content/PracticeCatalog";

const layers = getCurriculum();
const concepts = layers.flatMap((l) => l.concepts);
const ready = new Set((await getCollection("concepts")).map((e) => e.id));
const lessons = concepts.filter((c) => ready.has(c.id)).length;
const first = concepts.find((c) => ready.has(c.id));
const certs = practiceCatalog.listCertifications();
const exams = certs.reduce((s, c) => s + c.examCount, 0);
const questions = certs.reduce((s, c) => s + c.examCount * c.questionCount, 0);
// Lesson titles for the map's links, keyed by lesson id.
const titles = Object.fromEntries(concepts.map((c) => [c.id, c.title]));
const titlesEn = Object.fromEntries(concepts.map((c) => [c.id, c.titleEn]));
const features = [1, 2, 3] as const;
---
<BaseLayout title="AWS Thực Chiến" sidebar={false} wide>
  <section class="hero">
    <p class="hero-eyebrow"><T k="shell.home.eyebrow" /></p>
    <h1><T k="shell.home.title" /></h1>
    <p class="lede"><T k="shell.home.lede" /></p>
    <div class="hero-actions">
      {first && <a class="btn primary cta" href={`/concepts/${first.id}/`}><T k="shell.home.start" /></a>}
      <a class="btn cta" href="/on-tap/"><T k="shell.home.practice" /></a>
    </div>
    <dl class="hero-stats">
      <div><dt><T k="shell.home.statLessons" /></dt><dd>{lessons}</dd></div>
      <div><dt><T k="shell.home.statExams" /></dt><dd>{exams}</dd></div>
      <div><dt><T k="shell.home.statQuestions" /></dt><dd>{questions}</dd></div>
      <div><dt><T k="shell.home.statLanguages" /></dt><dd>VI · EN</dd></div>
    </dl>
  </section>

  <section class="home-map" aria-labelledby="map-title">
    <h2 id="map-title"><T k="shell.home.mapTitle" /></h2>
    <p class="home-sub"><T k="shell.home.mapLede" /></p>
    <ArchitectureMap client:visible titles={titles} titlesEn={titlesEn} />
  </section>

  <section class="home-features" aria-label="Cách học trên AWS Thực Chiến" data-i18n-attr="aria-label:shell.home.features">
    {features.map((n) => (
      <article class="feature">
        <span class="feature-n">0{n}</span>
        <h3><T k={`shell.home.f${n}Title`} /></h3>
        <p><T k={`shell.home.f${n}Body`} /></p>
      </article>
    ))}
  </section>
</BaseLayout>
