---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCurriculum } from "../data/exam";
import Importance from "../components/Importance.astro";
import ArchitectureMap from "../components/home/ArchitectureMap.tsx";

const layers = getCurriculum();
const ready = new Set((await getCollection("concepts")).map((e) => e.id));
const lessons = layers.reduce((s, l) => s + l.concepts.length, 0);
// Lesson titles for the map's links, keyed by lesson id.
const titles = Object.fromEntries(layers.flatMap((l) => l.concepts).map((c) => [c.id, c.title]));
---
<BaseLayout title="AWS Thực Chiến" sidebar={false} wide>
  <div class="crumbs"><b>Lộ trình SAA-C03</b></div>
  <h1>Kiến trúc tham chiếu của một hệ thống thương mại điện tử trên AWS</h1>
  <p class="lede">Sơ đồ mô tả luồng xử lý request qua các dịch vụ AWS trong hệ thống của ShopViet. Chọn một dịch vụ để mở bài học tương ứng.</p>

  <ArchitectureMap client:visible titles={titles} />

  <div class="home-start">
    <p>{lessons} bài học được sắp xếp theo lộ trình từ nền tảng đến nâng cao. Mỗi bài phân tích một yêu cầu thực tế của hệ thống ShopViet, đánh giá các dịch vụ AWS phù hợp và minh hoạ cơ chế hoạt động bằng mô phỏng tương tác. Nội dung được đối chiếu với tài liệu chính thức của AWS.</p>
    <a class="btn primary cta" href="/concepts/global-infra/">Bắt đầu: Global Infrastructure</a>
  </div>

  <div class="layer-grid">
    {layers.map((layer) => (
      <section class="layer-card">
        <h2><span class="layer-num">Lớp {layer.n}</span>{layer.name}</h2>
        <div class="concept-cards">
          {layer.concepts.map((c) => (
            <a class={"concept-card " + (ready.has(c.id) ? "ready" : "soon")} href={`/concepts/${c.id}/`}>
              <span class="title">{c.title}</span>
              <Importance level={c.importance} />
              <span class="state">{ready.has(c.id) ? "Đã có bài học" : "Đang biên soạn"}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
