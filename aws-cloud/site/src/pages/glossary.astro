---
import BaseLayout from "../layouts/BaseLayout.astro";
import L from "../components/L.astro";
import T from "../app/T.astro";
import FlowFigure from "../components/glossary/FlowFigure.tsx";
import { GLOSSARY } from "../data/glossary";
import { getCurriculum } from "../data/exam";

const layers = getCurriculum();
const concepts = layers.flatMap((l) => l.concepts.map((c) => ({ ...c, layer: l.n })));
const concept = (id: string) => concepts.find((c) => c.id === id)!;

/** Lower case without Vietnamese marks, so "do tre" finds "độ trễ"; the page script uses the same rule. */
const fold = (s: string) => s.normalize("NFD").replace(/\p{M}/gu, "").replace(/đ/g, "d").replace(/Đ/g, "d").toLowerCase();

const groups = layers
  .map((layer) => ({
    layer,
    terms: GLOSSARY.filter((t) => concept(t.lesson).layer === layer.n).map((t) => ({
      ...t,
      home: concept(t.lesson),
      search: fold([t.name, ...t.aliases, t.vi.def, t.en.def].join(" ")),
    })),
  }))
  .filter((g) => g.terms.length);
---
<BaseLayout title="Thuật ngữ · CloudLab" titleKey="shell.glossary.pageTitle" description="Thuật ngữ AWS dùng trong các bài học, định nghĩa theo tài liệu AWS." section="glossary" sidebar={false}>
  <header class="gl-head">
    <span class="gl-eyebrow"><T k="shell.glossary.eyebrow" /></span>
    <h1><T k="shell.glossary.title" /></h1>
    <p class="lede"><T k="shell.glossary.lede" params={{ n: GLOSSARY.length }} /></p>
  </header>

  <div class="mb-2 flex flex-col gap-3">
    <label class="gl-search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
      <input id="gl-q" type="search" autocomplete="off" placeholder="Tìm thuật ngữ, ví dụ: subnet, stateless, độ trễ" aria-label="Tìm thuật ngữ" data-i18n-attr="placeholder:shell.glossary.search;aria-label:shell.glossary.searchLabel" />
    </label>
    <div class="gl-filters" role="group" aria-label="Lọc theo lớp" data-i18n-attr="aria-label:shell.glossary.filter">
      <button type="button" class="gl-filter" data-filter="all" aria-pressed="true"><T k="shell.glossary.all" /> <b>{GLOSSARY.length}</b></button>
      {groups.map((g) => (
        <button type="button" class="gl-filter" data-filter={String(g.layer.n)} aria-pressed="false" style={`--layer: var(--l${g.layer.n})`}>
          <i aria-hidden="true" /><L vi={g.layer.name} en={g.layer.nameEn} /> <b>{g.terms.length}</b>
        </button>
      ))}
    </div>
  </div>

  {groups.map((g) => (
    <section class="gl-layer mt-[26px]" data-layer={String(g.layer.n)} style={`--layer: var(--l${g.layer.n})`}>
      <h2 class="mb-3.5 flex items-baseline gap-3 text-step-2"><span class="font-mono text-[0.8rem] font-medium text-(--layer)"><L vi={`Lớp ${g.layer.n}`} en={`Layer ${g.layer.n}`} /></span><L vi={g.layer.name} en={g.layer.nameEn} /></h2>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(min(330px,100%),1fr))] gap-3.5">
        {g.terms.map((t) => (
          <article class="gl-card" id={t.id} data-layer={String(g.layer.n)} data-search={t.search}>
            <h3 class="m-0 text-[1.05rem] leading-[1.3]"><a class="text-inherit no-underline" href={`#${t.id}`}>{t.name}</a></h3>
            <div class="gl-body">
              <p class="m-0 text-[0.94rem] leading-[1.6] text-pretty"><L vi={t.vi.def} en={t.en.def} /></p>
              {t.flow && <FlowFigure flow={t.flow} lang="both" />}
              {t.vi.example && (
                <p class="m-0 text-[0.85rem] leading-[1.55] text-muted"><b class="font-semibold text-edge"><T k="shell.glossary.example" /></b> <L vi={t.vi.example} en={t.en.example} /></p>
              )}
            </div>
            <div class="flex flex-none flex-wrap gap-x-4 gap-y-1.5 border-t border-dashed border-line pt-2.5 text-[0.85rem] font-semibold">
              <a class="no-underline" href={`/concepts/${t.lesson}/`}><L vi={`Học kỹ ở bài ${t.home.title}`} en={`Covered in ${t.home.titleEn}`} /> →</a>
              <a class="text-muted no-underline" href={t.docs} target="_blank" rel="noopener"><T k="shell.glossary.docs" /> ↗</a>
            </div>
          </article>
        ))}
      </div>
      <button type="button" class="gl-more mt-3.5 flex min-h-12 w-full cursor-pointer items-center justify-center gap-2.5 rounded-[20px] border border-dashed border-[color-mix(in_srgb,var(--layer)_55%,var(--color-line))] bg-surface font-semibold text-ink transition-[background,border-color,transform] duration-200 hover:-translate-y-px hover:border-solid hover:border-(--layer)" hidden>
        <span data-lang="vi">Xem thêm <b class="text-(--layer)" data-more-n></b> thuật ngữ</span><span data-lang="en">Show <b class="text-(--layer)" data-more-n></b> more terms</span>
        <small class="font-medium text-muted"><span data-lang="vi">còn <i data-left-n></i></span><span data-lang="en"><i data-left-n></i> left</span></small>
      </button>
    </section>
  ))}
  <p class="gl-empty py-10 text-center text-muted" hidden><T k="shell.glossary.empty" /></p>

  <script>
    const fold = (s: string) => s.normalize("NFD").replace(/\p{M}/gu, "").replace(/đ/g, "d").replace(/Đ/g, "d").toLowerCase();
    const input = document.getElementById("gl-q") as HTMLInputElement;
    const filters = [...document.querySelectorAll<HTMLButtonElement>(".gl-filter")];
    const empty = document.querySelector<HTMLElement>(".gl-empty")!;
    const sections = [...document.querySelectorAll<HTMLElement>(".gl-layer")];
    /** Cards shown per layer before "Show more", and how many each click adds. */
    const PAGE = 6;
    const limits = new Map(sections.map((s) => [s, PAGE]));
    let layer = "all";

    function apply() {
      const q = fold(input.value.trim());
      let shown = 0;
      for (const section of sections) {
        const matches = [...section.querySelectorAll<HTMLElement>(".gl-card")].filter(
          (card) => (layer === "all" || card.dataset.layer === layer) && (!q || card.dataset.search!.includes(q)),
        );
        const limit = limits.get(section)!;
        section.querySelectorAll<HTMLElement>(".gl-card").forEach((card) => {
          const at = matches.indexOf(card);
          card.hidden = at < 0 || at >= limit;
        });
        const left = Math.max(0, matches.length - limit);
        const more = section.querySelector<HTMLElement>(".gl-more")!;
        more.hidden = left === 0;
        more.querySelectorAll("[data-more-n]").forEach((n) => (n.textContent = String(Math.min(PAGE, left))));
        more.querySelectorAll("[data-left-n]").forEach((n) => (n.textContent = String(left)));
        section.hidden = matches.length === 0;
        shown += matches.length;
      }
      empty.hidden = shown > 0;
    }

    /** Back to the first page of every layer whenever the search or the filter changes. */
    function reset() {
      for (const s of sections) limits.set(s, PAGE);
      apply();
    }

    /** A link to /glossary/#term opens enough of its layer to show that card. */
    function reveal() {
      const card = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      const section = card?.closest<HTMLElement>(".gl-layer");
      if (!card || !section) return;
      const index = [...section.querySelectorAll(".gl-card")].indexOf(card);
      limits.set(section, Math.max(limits.get(section)!, Math.ceil((index + 1) / PAGE) * PAGE));
      apply();
      card.scrollIntoView({ block: "start" });
    }

    input.addEventListener("input", reset);
    for (const button of filters) {
      button.addEventListener("click", () => {
        layer = button.dataset.filter!;
        for (const b of filters) b.setAttribute("aria-pressed", String(b === button));
        reset();
      });
    }
    for (const section of sections) {
      section.querySelector(".gl-more")!.addEventListener("click", () => {
        limits.set(section, limits.get(section)! + PAGE);
        apply();
      });
    }
    /** Fade the bottom of a card whose text runs past its fixed height, until it is scrolled to the end. */
    const fade = (body: HTMLElement) => {
      body.classList.toggle("scrolls", body.scrollHeight > body.clientHeight + 1);
      body.classList.toggle("at-end", body.scrollTop + body.clientHeight >= body.scrollHeight - 2);
    };
    const bodies = [...document.querySelectorAll<HTMLElement>(".gl-body")];
    // Watch the content as well as the body: the body's height is fixed, its text changes with the language.
    const resized = new ResizeObserver((entries) => entries.forEach((e) => fade(e.target.closest<HTMLElement>(".gl-body")!)));
    for (const body of bodies) {
      resized.observe(body);
      for (const child of body.children) resized.observe(child);
      body.addEventListener("scroll", () => fade(body), { passive: true });
    }
    window.addEventListener("hashchange", reveal);
    apply();
    reveal();
  </script>
</BaseLayout>
