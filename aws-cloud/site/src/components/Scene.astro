---
import { assertListed, getCurriculum } from "../data/exam";
import { stripTerms } from "../data/glossary-scan";
import { lessonRoute, partOfScene } from "../data/lesson-parts";
import { spellings } from "../data/glossary-rules";
import T from "../app/T.astro";
import KeywordStrip, { type StripTerm } from "./glossary/KeywordStrip.tsx";

interface Props {
  id: string;
  label: string;
  title: string;
  /** Practice-test questions this scene teaches for, e.g. "exam1_q41". */
  questions?: string[];
}
const { id, label, title, questions = [] } = Astro.props;
assertListed(questions, `Scene "${id}"`);

// Each part of a lesson is its own page (/concepts/<lesson>/<slug>/): a scene renders only there,
// so the overview page and the other parts carry neither its markup nor its islands.
const route = lessonRoute(Astro.url.pathname);
const lesson = route?.lesson;
const part = lesson ? partOfScene(lesson, id) : undefined;
const visible = !route || (part !== undefined && part.slug === route.part);

// Key terms the scene introduces, read from the lesson source at build time. English scenes
// carry an "en-" id prefix.
const concepts = getCurriculum().flatMap((l) => l.concepts);
const terms: StripTerm[] = lesson && visible
  ? stripTerms(id.startsWith("en-") ? "en" : "vi", lesson, id).map((t) => {
      const home = concepts.find((c) => c.id === t.lesson)!;
      return {
        id: t.id,
        name: t.name,
        docs: t.docs,
        flow: t.flow,
        spell: spellings(t),
        vi: t.vi,
        en: t.en,
        learn: t.lesson === lesson ? undefined : { id: home.id, vi: home.title, en: home.titleEn },
      };
    })
  : [];
---
{visible && (
  <section class="scene prose mt-11 scroll-mt-20" id={id}>
    <div class="scene-head mb-1 flex flex-col items-start gap-0.5">
      <span class="text-[0.8125rem] font-bold tracking-[0.08em] text-accent uppercase">{label}{part && <> · <T k="lesson.parts.minutes" params={{ n: part.minutes }} /></>}</span>
      {route ? <h1 class="mt-1 mb-0 text-[clamp(1.6rem,3vw,2.1rem)] leading-[1.2] tracking-[-0.015em]">{title}</h1> : <h2>{title}</h2>}
    </div>
    {terms.length > 0 && <KeywordStrip client:idle terms={terms} />}
    <slot />
  </section>
)}
