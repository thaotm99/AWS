---
// On-premises ↔ AWS: Site-to-Site VPN over the internet vs Direct Connect virtual interfaces.
---
<div class="stage">
  <div class="svg-wrap">
    <svg viewBox="0 0 760 330" role="img" aria-label="Văn phòng on-premises nối với AWS qua Site-to-Site VPN trên internet và qua Direct Connect với các loại virtual interface">
      <rect class="region" x="20" y="40" width="170" height="250" rx="12" />
      <text class="t" x="36" y="64">On-premises</text>
      <g class="res res-site"><rect x="40" y="90" width="130" height="40" rx="7" /><text class="res-t" x="105" y="108" text-anchor="middle">Customer gateway</text><text class="res-s" x="105" y="122" text-anchor="middle">router của bạn</text></g>
      <g class="res res-site"><rect x="40" y="210" width="130" height="40" rx="7" /><text class="res-t" x="105" y="235" text-anchor="middle">Router DX</text></g>

      <path class="vpn-line" d="M170 110 C 290 70, 420 70, 540 100" />
      <text class="ts" x="355" y="62" text-anchor="middle">Site-to-Site VPN: IPsec qua internet · mã hóa · dựng nhanh</text>

      <rect class="dx-loc" x="250" y="200" width="110" height="60" rx="8" />
      <text class="ts" x="305" y="224" text-anchor="middle">Direct Connect</text>
      <text class="ts" x="305" y="238" text-anchor="middle">location</text>
      <path class="dx-line" d="M170 230 H250" />
      <text class="ts" x="210" y="276" text-anchor="middle">đường riêng</text>
      <text class="ts" x="210" y="288" text-anchor="middle">không mã hóa sẵn</text>

      <path class="dx-line" d="M360 215 C 430 200, 470 140, 540 132" />
      <text class="vif-t" x="430" y="166">private VIF</text>
      <path class="dx-line" d="M360 230 C 440 230, 480 230, 540 232" />
      <text class="vif-t" x="430" y="224">transit VIF</text>
      <path class="dx-line" d="M360 248 C 430 270, 480 300, 540 300" />
      <text class="vif-t" x="430" y="292">public VIF</text>

      <rect class="region" x="540" y="20" width="200" height="300" rx="12" />
      <text class="t" x="556" y="42">AWS</text>
      <g class="res res-net"><rect x="560" y="90" width="160" height="50" rx="7" /><text class="res-t" x="640" y="110" text-anchor="middle">Virtual private gateway</text><text class="res-s" x="640" y="126" text-anchor="middle">gắn vào 1 VPC</text></g>
      <g class="res res-net"><rect x="560" y="210" width="160" height="46" rx="7" /><text class="res-t" x="640" y="229" text-anchor="middle">DX gateway + TGW</text><text class="res-s" x="640" y="244" text-anchor="middle">nhiều VPC, nhiều Region</text></g>
      <g class="res res-store"><rect x="560" y="282" width="160" height="30" rx="7" /><text class="res-t" x="640" y="302" text-anchor="middle">S3 (endpoint public)</text></g>
    </svg>
  </div>
</div>
