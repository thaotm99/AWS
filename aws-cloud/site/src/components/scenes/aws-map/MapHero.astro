---
// Lesson 0 opening visual: the six service groups orbiting MFTech. CSS-only motion (aws-map.css).
import "./aws-map.css";
import L from "../../L.astro";
import { lessonRoute } from "../../../data/lesson-parts";

// Shown on the lesson overview only.
const onOverview = !lessonRoute(Astro.url.pathname)?.part;

const GROUPS = [
  { vi: "Mạng", en: "Networking", c: "var(--color-map-cyan)" },
  { vi: "Bảo mật", en: "Security", c: "var(--color-map-violet)" },
  { vi: "Tính toán", en: "Compute", c: "var(--color-map-amber)" },
  { vi: "Lưu trữ", en: "Storage", c: "var(--color-map-green)" },
  { vi: "Database", en: "Database", c: "var(--color-map-blue)" },
  { vi: "Tích hợp", en: "Integration", c: "var(--color-map-pink)" },
].map((g, i, all) => {
  const a = (i / all.length) * 360 - 90;
  const r = (a * Math.PI) / 180;
  return { ...g, a, x: 50 + Math.cos(r) * 36, y: 50 + Math.sin(r) * 36, d: i * 0.43, f: 3 + i * 0.4 };
});
---
{onOverview && (
<div class="am-hero relative mx-0 mt-1.5 mb-[22px] grid grid-cols-[minmax(0,1fr)_minmax(280px,420px)] items-center gap-3 overflow-hidden rounded-[26px] border border-map-cyan/14 bg-[radial-gradient(120%_140%_at_85%_20%,var(--color-map-glow-hero)_0%,var(--color-map-bg)_55%)] px-8 py-7 text-map-ink max-md:grid-cols-1 max-md:px-[18px] max-md:py-[22px]">
  <div>
    <span class="mb-2.5 block font-mono text-[0.75rem] tracking-[0.14em] text-map-amber"><L vi="LỚP 0 · BẮT ĐẦU" en="LAYER 0 · START HERE" /></span>
    <h2 class="m-0 mb-2.5 text-[length:clamp(1.6rem,3.4vw,2.3rem)] leading-[1.12] font-extrabold tracking-[-0.02em] text-map-ink"><L vi="Bản đồ AWS cho người mới" en="An AWS map for newcomers" /></h2>
    <p class="m-0 max-w-[46ch] leading-[1.6] text-map-soft"><L vi="Nhìn toàn cảnh trước khi đi vào từng dịch vụ: cloud khác gì tự vận hành máy chủ, mỗi nhóm dịch vụ làm gì, và một đơn hàng của MFTech đi qua những đâu." en="See the whole picture before the individual services: how cloud differs from running your own servers, what each group of services does, and where one MFTech order travels." /></p>
  </div>
  <div class="relative aspect-square w-full max-w-[380px] justify-self-center max-md:max-w-[300px]" role="img" aria-label="Sáu nhóm dịch vụ AWS quanh hệ thống MFTech" data-i18n-attr="aria-label:lesson.awsMap.heroLabel">
    <span class="absolute inset-[14%] rounded-[50%] border border-map-ring"></span>
    {GROUPS.map((g) => <span class="am-spoke" style={`--a:${g.a}deg; --c:${g.c}; --d:${g.d}s`}><i></i></span>)}
    <span class="am-sat"></span>
    <span class="am-core">MFTech</span>
    {GROUPS.map((g) => (
      <span class="am-orb" style={`left:${g.x.toFixed(1)}%; top:${g.y.toFixed(1)}%; --c:${g.c}; --d:${g.d}s; --f:${g.f}s`}><L vi={g.vi} en={g.en} /></span>
    ))}
  </div>
</div>
)}
