---
import QRCode from "qrcode";
import T from "../app/T.astro";
import { DONATE } from "../data/donate";
import { vietQrPayload } from "../lib/vietqr";

const qr = await QRCode.toString(vietQrPayload(DONATE), { type: "svg", margin: 1, errorCorrectionLevel: "M" });
const fields = [
  { key: "bank", value: DONATE.bank },
  { key: "account", value: DONATE.account, copy: true },
  { key: "holder", value: DONATE.holder },
  { key: "note", value: DONATE.note, copy: true, strong: true },
] as const;
---
<aside class="donate mt-12 grid grid-cols-[minmax(0,1fr)_200px] items-start gap-x-6 gap-y-5 rounded-[20px] border border-edge bg-bg px-5.5 py-5 max-sm:grid-cols-[minmax(0,1fr)] max-sm:p-4" aria-labelledby="donate-title">
  <div>
    <h2 class="mt-0 mb-1.5 text-step-1" id="donate-title"><span aria-hidden="true">☕</span> <T k="shell.donate.title" /></h2>
    <p class="mt-0 mb-3.5 text-[0.9375rem] text-muted"><T k="shell.donate.body" /></p>
    <dl class="m-0 grid gap-2">
      {fields.map((f) => (
        <div class:list={["min-w-0 rounded-[14px] border bg-surface px-3 py-2", "strong" in f && f.strong ? "border-edge" : "border-line"]}>
          <dt class:list={["text-[0.75rem]", "strong" in f && f.strong ? "font-semibold text-edge" : "text-muted"]}><T k={`shell.donate.${f.key}`} /></dt>
          <dd class="m-0 flex flex-wrap items-center justify-between gap-2.5">
            <span class="font-mono text-[0.9375rem] font-semibold wrap-anywhere">{f.value}</span>
            {"copy" in f && f.copy && (
              <button type="button" class="min-h-8 flex-none cursor-pointer rounded-sm border border-edge bg-transparent px-2.5 py-0.75 text-[0.8125rem] font-semibold text-edge hover:bg-edge hover:text-surface [&.done]:bg-edge [&.done]:text-surface" data-copy={f.value}><T k="shell.donate.copy" /></button>
            )}
          </dd>
        </div>
      ))}
    </dl>
    <p class="mx-0 mt-3.5 mb-0 text-[0.9375rem] text-muted"><T k="shell.donate.hint" /></p>
  </div>
  <figure class="m-0 text-center max-sm:max-w-[220px] max-sm:justify-self-center">
    <div class="rounded-[18px] border border-line bg-white p-2.5 [&_svg]:block [&_svg]:h-auto [&_svg]:w-full" set:html={qr} />
    <figcaption class="mt-2 text-[0.75rem] text-muted"><T k="shell.donate.scan" /></figcaption>
  </figure>
  <span class="donate-copied" hidden><T k="shell.donate.copied" /></span>
</aside>

<script>
  for (const box of document.querySelectorAll<HTMLElement>(".donate")) {
    box.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-copy]");
      if (!btn) return;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
      } catch {
        return;
      }
      const label = btn.innerHTML;
      btn.textContent = box.querySelector(".donate-copied")?.textContent ?? "✓";
      btn.classList.add("done");
      setTimeout(() => {
        btn.innerHTML = label;
        btn.classList.remove("done");
      }, 1600);
    });
  }
</script>
