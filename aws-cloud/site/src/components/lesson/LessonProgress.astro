---
// Lesson overview, top of the page: parts read, a bar per part and the Start / Continue link.
// LessonParts (further down the page) fills them in from the saved progress.
import L from "../L.astro";
import T from "../../app/T.astro";
import type { LessonPart } from "../../data/lesson-parts";

interface Props {
  lesson: string;
  parts: LessonPart[];
}
const { lesson, parts } = Astro.props;
const first = parts[0];
const head = (s: string) => s.split(": ")[0];
const firstHref = `/concepts/${lesson}/${first.slug}/`;
// The link names its verb (start, continue, read again); LessonParts sets data-verb and only that one shows.
const verb = "hidden after:content-[':']";
---
<div class="mt-[22px] mb-2 grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-5 gap-y-3 rounded-lg border border-line bg-surface px-5 py-[18px] shadow-soft max-sm:grid-cols-[minmax(0,1fr)] max-sm:p-3.5">
  <div class="flex items-baseline gap-3 text-[0.9375rem]">
    <b><T k="lesson.parts.progress" /></b>
    <span class="font-mono text-[0.8125rem] font-semibold text-ok"><span data-lp-done>0</span> / {parts.length}</span>
    <span class="lp-complete ml-auto text-[0.8125rem] font-semibold text-ok" hidden><T k="lesson.parts.complete" /></span>
  </div>
  <div class="lp-bar col-[1] flex gap-[3px]" aria-hidden="true">
    {parts.map((p) => <i class="h-1.5 flex-1 rounded-[3px] bg-line transition-[background] duration-300 data-[state=current]:bg-accent data-[state=read]:bg-ok" data-slug={p.slug} data-kind={p.kind} />)}
  </div>
  <a class="btn cta group col-[2] row-[1/span_2] max-w-[380px] gap-1.5 whitespace-nowrap max-sm:col-[1] max-sm:row-auto max-sm:max-w-none max-sm:whitespace-normal" href={firstHref} data-lp-cta>
    <span class={`${verb} group-not-data-verb:inline group-data-[verb=start]:inline`} data-verb="start"><T k="lesson.parts.start" /></span>
    <span class={`${verb} group-data-[verb=resume]:inline`} data-verb="resume"><T k="lesson.parts.resume" /></span>
    <span class={`${verb} group-data-[verb=again]:inline`} data-verb="again"><T k="lesson.parts.again" /></span>
    <span class="overflow-hidden text-ellipsis" data-lp-cta-title><L vi={head(first.title.vi)} en={head(first.title.en)} /></span>
    <span aria-hidden="true">→</span>
  </a>
  <div class="col-span-full flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-dashed border-line pt-2.5">
    <button type="button" class="btn lp-save" data-urls={JSON.stringify([`/concepts/${lesson}/`, ...parts.map((p) => `/concepts/${lesson}/${p.slug}/`)])}>
      <T k="shell.offline.save" />
    </button>
    <span class="lp-save-status text-[0.8125rem] text-muted" role="status" aria-live="polite"></span>
  </div>
</div>

<script>
  import { i18n } from "../../app/i18n";

  // Asks the service worker to store the overview and every part of the lesson, with their files.
  const button = document.querySelector<HTMLButtonElement>(".lp-save");
  const status = document.querySelector<HTMLElement>(".lp-save-status");
  const say = (key: string, params?: Record<string, number>) => {
    if (status) status.textContent = (i18n.translator() as unknown as { lookup(k: string, p?: object): string }).lookup(key, params);
  };
  if (button && status) {
    if (!("serviceWorker" in navigator)) button.hidden = true;
    button.addEventListener("click", async () => {
      const reg = await navigator.serviceWorker.ready.catch(() => null);
      if (!reg?.active) return say("shell.offline.unsupported");
      const urls: string[] = JSON.parse(button.dataset.urls!);
      const channel = new MessageChannel();
      button.disabled = true;
      say("shell.offline.saving", { done: 0, total: urls.length });
      channel.port1.onmessage = ({ data }) => {
        if (data.type === "progress") say("shell.offline.saving", { done: data.done, total: data.total });
        else {
          button.disabled = false;
          if (data.type === "done") say("shell.offline.done", { n: data.pages });
          else say("shell.offline.failed");
        }
      };
      reg.active.postMessage({ type: "save-lesson", urls }, [channel.port2]);
    });
  }
</script>
