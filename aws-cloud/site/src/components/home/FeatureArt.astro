---
// Animated illustrations for the home page: one small scene per feature, plus the hero scene.
// Pure SVG + CSS (no script); motion stops under prefers-reduced-motion. Labels are AWS names, the same in both languages.
import "./feature-art.css";

interface Props {
  kind: "hero" | "lessons" | "practice" | "lab" | "skills" | "compare" | "flashcards" | "notes" | "progress";
  /** Extra classes for the <svg> (size limits where it is placed). */
  class?: string;
}
const { kind, class: extra } = Astro.props;
const box = (x: number, y: number, w: number, h: number, label: string, cls = "") => ({ x, y, w, h, label, cls });
---
{kind === "hero" && (
  <svg class:list={["fa fa-hero", extra]} viewBox="0 0 520 360" aria-hidden="true">
    <rect class="fa-region" x="150" y="24" width="352" height="312" rx="16" />
    <text class="fa-cap" x="166" y="46">REGION · ap-southeast-1</text>
    <rect class="fa-az" x="246" y="66" width="114" height="250" rx="12" />
    <rect class="fa-az" x="374" y="66" width="114" height="250" rx="12" />
    <text class="fa-cap" x="258" y="86">AZ a</text>
    <text class="fa-cap" x="386" y="86">AZ b</text>
    <path class="fa-wire" d="M58 180 H96 M180 180 H188 M266 128 H 303 M266 232 H303 M210 180 V128 H246 M210 180 V232 H246 M303 128 V150 M303 232 V254 M359 270 H431 M303 128 H431 M431 128 V150" />
    <g class="fa-user"><circle cx="38" cy="168" r="12" /><path d="M18 204 q20 -26 40 0" /></g>
    {[
      box(96, 160, 84, 40, "CloudFront", "net"),
      box(188, 160, 44, 40, "ALB", "net"),
      box(270, 150, 66, 40, "EC2", "cmp"),
      box(398, 150, 66, 40, "EC2", "cmp"),
      box(270, 254, 66, 40, "RDS", "dat"),
      box(398, 254, 66, 40, "Standby", "dat"),
    ].map((b) => (
      <g class:list={["fa-node", b.cls]}>
        <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="8" />
        <text x={b.x + b.w / 2} y={b.y + b.h / 2 + 4} text-anchor="middle">{b.label}</text>
      </g>
    ))}
    <path class="fa-sync" d="M336 274 H398" />
    <circle class="fa-dot d1" r="5" style="offset-path: path('M58 180 H210 V128 H303 V150')" />
    <circle class="fa-dot d2" r="5" style="offset-path: path('M58 180 H210 V128 H431 V150')" />
    <circle class="fa-dot d3" r="5" style="offset-path: path('M303 190 V254')" />
    <circle class="fa-pulse" cx="303" cy="170" r="30" />
  </svg>
)}

{kind === "lessons" && (
  <svg class:list={["fa", extra]} viewBox="0 0 320 200" aria-hidden="true">
    <rect class="fa-az" x="150" y="20" width="70" height="160" rx="10" />
    <rect class="fa-az fa-fail" x="234" y="20" width="70" height="160" rx="10" />
    <text class="fa-cap" x="160" y="38">AZ a</text>
    <text class="fa-cap" x="244" y="38">AZ b</text>
    <g class="fa-node net"><rect x="20" y="80" width="64" height="40" rx="8" /><text x="52" y="104" text-anchor="middle">ALB</text></g>
    <g class="fa-node cmp"><rect x="160" y="80" width="50" height="40" rx="8" /><text x="185" y="104" text-anchor="middle">EC2</text></g>
    <g class="fa-node cmp fa-down"><rect x="244" y="80" width="50" height="40" rx="8" /><text x="269" y="104" text-anchor="middle">EC2</text></g>
    <path class="fa-wire" d="M84 100 H160 M84 100 Q170 160 244 100" />
    <text class="fa-x" x="269" y="150" text-anchor="middle">✕</text>
    <circle class="fa-dot d1" r="5" style="offset-path: path('M84 100 H160')" />
    <circle class="fa-dot d2" r="5" style="offset-path: path('M84 100 H160')" />
  </svg>
)}

{kind === "practice" && (
  <svg class:list={["fa", extra]} viewBox="0 0 320 200" aria-hidden="true">
    <rect class="fa-card" x="20" y="16" width="220" height="168" rx="12" />
    <rect class="fa-line" x="36" y="32" width="170" height="8" rx="4" />
    <rect class="fa-line" x="36" y="46" width="130" height="8" rx="4" />
    {[0, 1, 2, 3].map((i) => (
      <g class:list={["fa-opt", { right: i === 2 }]} style={`--i:${i}`}>
        <rect x="36" y={70 + i * 26} width="188" height="20" rx="6" />
        <circle cx="48" cy={80 + i * 26} r="4" />
      </g>
    ))}
    <text class="fa-check" x="212" y={70 + 2 * 26 + 15} text-anchor="middle">✓</text>
    <circle class="fa-timer-track" cx="276" cy="60" r="26" />
    <circle class="fa-timer" cx="276" cy="60" r="26" />
    <text class="fa-cap fa-timer-label" x="276" y="64" text-anchor="middle">130′</text>
    <rect class="fa-score" x="252" y="110" width="48" height="60" rx="8" />
    <text class="fa-score-n" x="276" y="146" text-anchor="middle">72%</text>
  </svg>
)}

{kind === "lab" && (
  <svg class:list={["fa", extra]} viewBox="0 0 320 200" aria-hidden="true">
    <rect class="fa-region" x="16" y="16" width="288" height="168" rx="12" />
    {[
      box(34, 36, 70, 34, "Route 53", "net"),
      box(126, 36, 70, 34, "CloudFront", "net"),
      box(218, 36, 70, 34, "S3", "dat"),
      box(34, 96, 70, 34, "ALB", "net"),
      box(126, 96, 70, 34, "ASG", "cmp"),
      box(218, 96, 70, 34, "Aurora", "dat"),
    ].map((b, i) => (
      <g class:list={["fa-node fa-drop", b.cls]} style={`--i:${i}`}>
        <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="7" />
        <text x={b.x + b.w / 2} y={b.y + 21} text-anchor="middle">{b.label}</text>
      </g>
    ))}
    <g class="fa-pass"><rect x="96" y="146" width="128" height="26" rx="13" /><text x="160" y="163" text-anchor="middle">✓ PASS</text></g>
  </svg>
)}

{kind === "skills" && (
  <svg class:list={["fa", extra]} viewBox="0 0 320 200" aria-hidden="true">
    <path class="fa-axis" d="M30 170 H300 M30 20 V170" />
    {[0.82, 0.64, 0.9, 0.48].map((v, i) => (
      <g style={`--i:${i};--v:${v}`}>
        <rect class="fa-bar-bg" x={52 + i * 62} y="30" width="40" height="140" rx="6" />
        <rect class:list={["fa-bar", { weak: v < 0.6 }]} x={52 + i * 62} y="30" width="40" height="140" rx="6" />
        <text class="fa-cap" x={72 + i * 62} y="188" text-anchor="middle">D{i + 1}</text>
      </g>
    ))}
  </svg>
)}

{kind === "compare" && (
  <svg class:list={["fa", extra]} viewBox="0 0 320 200" aria-hidden="true">
    <g class="fa-node dat"><rect x="120" y="16" width="80" height="30" rx="7" /><text x="160" y="36" text-anchor="middle">EFS</text></g>
    <g class="fa-node dat"><rect x="220" y="16" width="80" height="30" rx="7" /><text x="260" y="36" text-anchor="middle">FSx</text></g>
    {[0, 1, 2, 3].map((i) => (
      <g style={`--i:${i}`}>
        <rect class="fa-line" x="20" y={66 + i * 32} width="86" height="10" rx="5" />
        <text class="fa-mark ok" x="160" y={76 + i * 32} text-anchor="middle">✓</text>
        <text class:list={["fa-mark", i % 2 ? "ok" : "bad"]} x="260" y={76 + i * 32} text-anchor="middle">{i % 2 ? "✓" : "✕"}</text>
      </g>
    ))}
  </svg>
)}

{kind === "flashcards" && (
  <svg class:list={["fa", extra]} viewBox="0 0 320 200" aria-hidden="true">
    <rect class="fa-card back2" x="92" y="34" width="150" height="132" rx="12" transform="rotate(-6 167 100)" />
    <g class="fa-flip">
      <g class="fa-face front">
        <rect class="fa-card" x="84" y="30" width="150" height="132" rx="12" />
        <text class="fa-term" x="159" y="102" text-anchor="middle">NAT gateway</text>
      </g>
      <g class="fa-face backface">
        <rect class="fa-card accent" x="84" y="30" width="150" height="132" rx="12" />
        <rect class="fa-line" x="104" y="64" width="110" height="8" rx="4" />
        <rect class="fa-line" x="104" y="80" width="90" height="8" rx="4" />
        <rect class="fa-line" x="104" y="96" width="100" height="8" rx="4" />
        <text class="fa-cap" x="159" y="140" text-anchor="middle">+3d · +7d · +14d</text>
      </g>
    </g>
  </svg>
)}

{kind === "notes" && (
  <svg class:list={["fa", extra]} viewBox="0 0 320 200" aria-hidden="true">
    <rect class="fa-card" x="20" y="16" width="210" height="168" rx="12" />
    {[0, 1, 2, 3, 4, 5].map((i) => <rect class="fa-line" x="38" y={38 + i * 22} width={i === 5 ? 110 : 174} height="8" rx="4" />)}
    <rect class="fa-hl" x="34" y="78" width="182" height="16" rx="3" />
    <g class="fa-sticky"><rect x="218" y="60" width="86" height="80" rx="6" /><rect class="fa-line dark" x="230" y="78" width="60" height="6" rx="3" /><rect class="fa-line dark" x="230" y="92" width="48" height="6" rx="3" /><rect class="fa-line dark" x="230" y="106" width="54" height="6" rx="3" /></g>
  </svg>
)}

{kind === "progress" && (
  <svg class:list={["fa", extra]} viewBox="0 0 320 200" aria-hidden="true">
    <circle class="fa-timer-track" cx="74" cy="100" r="46" />
    <circle class="fa-ring" cx="74" cy="100" r="46" />
    <text class="fa-score-n" x="74" y="106" text-anchor="middle">7</text>
    <text class="fa-cap" x="74" y="124" text-anchor="middle">streak</text>
    {Array.from({ length: 21 }, (_, i) => (
      <rect class="fa-cell" x={150 + (i % 7) * 22} y={46 + Math.floor(i / 7) * 36} width="18" height="28" rx="4" style={`--i:${i}`} />
    ))}
  </svg>
)}
