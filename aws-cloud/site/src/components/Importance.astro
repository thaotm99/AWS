---
import T from "../app/T.astro";
import { IMPORTANCE_NAMES, type Importance } from "../data/curriculum";

interface Props {
  level: Importance;
  /** Also show the one-line explanation. */
  hint?: boolean;
}

const { level, hint = false } = Astro.props;
const name = IMPORTANCE_NAMES[level];
---
<span class="inline-flex flex-wrap items-center gap-1.5">
  <span class={`imp imp-${level}`} aria-hidden="true"><i></i><i></i><i></i></span>
  <T k={`shell.importance.${name}`} />
  {hint && <span class="basis-full text-muted"><T k={`shell.importance.${name}Hint`} /></span>}
</span>
